# Copy to .env for `just up` in the dev container.
INNBY_LISTEN=0.0.0.0:8080
# DATABASE_URL is preset in the devcontainer.
# The site's origin, without a path. Links in the admin UI and mails start with it.
INNBY_BASE_URL=http://localhost:8080
# Signs every guest link; rotating it breaks all of them. Dev only, make a real one
# with `openssl rand -base64 32`.
INNBY_LINK_KEY=ZGV2LW9ubHktbGluay1rZXktZG8tbm90LXVzZS1pbi1wcm9k
# The data controller named in the privacy notice: you, the host.
INNBY_CONTROLLER_NAME="Kari Nordmann"
INNBY_CONTROLLER_EMAIL=kari@example.com
# The service mail is sent through, as the privacy notice names it: the company and its
# country, e.g. "MailerSend (MailerSend UAB, Lithuania)". Unset, the notice says mail
# goes through the host's own server.
# INNBY_MAIL_PROCESSOR="MailerSend (MailerSend UAB, Lithuania)"
# Where the site runs, if a provider's servers hold its data: e.g. "Hetzner Online GmbH,
# Germany". Unset, the notice says the host's own server.
# INNBY_HOSTING="Hetzner Online GmbH, Germany"
# The data protection authority guests may complain to, and its page. Unset, the notice
# says the one where the guest or the host is.
# INNBY_AUTHORITY_NAME=Datatilsynet
# INNBY_AUTHORITY_URL=https://www.datatilsynet.no/en/
# Behind the cluster gateway: rate-limit by the X-Forwarded-For address it appends, for
# the site's forms and the admin login.
# INNBY_TRUST_FORWARDED=true
# Anonymous metrics for Prometheus, at /metrics on a port of their own that no route
# reaches: requests by route pattern, mail, the outbox, database connections, memory.
# Unset, none. `just up` gives each workload its own, inside the dev container: the
# site :9090, the admin UI :9091, the mailer :9092.
# INNBY_METRICS_LISTEN=0.0.0.0:9090
# innby admin: the host's login. Dev only: this is the hash of "innby". Make a real one
# with `just innby hash-password`.
INNBY_ADMIN_LISTEN=0.0.0.0:8081
INNBY_ADMIN_USER=admin
INNBY_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$eLkGWlrGr/4XIS1NIZhXQg$iMXvMhwsbHC/aFb/aAT34dDpXBp4PdHRrw286uFP1zo'
# More users with a password, each name:role:hash, apart by spaces or lines; the role is
# admin, creator, editor, organiser, viewer, or none for a user who sees only the events an
# admin gives them a role for. Dev only, each with the password "innby" too: an editor, an
# organiser and a viewer of every event; nobody, with no role and no events; and helper, with no role of their
# own but a viewer of the Christmas party, which the sample data gives them.
INNBY_ADMIN_USERS='editor:editor:$argon2id$v=19$m=19456,t=2,p=1$KVfWkfxeraBv8o0qqkHGUA$8m+56g0B/rw+fhbZDZnkrNghAO+B6zLcDz3mPlHvWOg organiser:organiser:$argon2id$v=19$m=19456,t=2,p=1$KVfWkfxeraBv8o0qqkHGUA$8m+56g0B/rw+fhbZDZnkrNghAO+B6zLcDz3mPlHvWOg viewer:viewer:$argon2id$v=19$m=19456,t=2,p=1$KVfWkfxeraBv8o0qqkHGUA$8m+56g0B/rw+fhbZDZnkrNghAO+B6zLcDz3mPlHvWOg nobody:none:$argon2id$v=19$m=19456,t=2,p=1$KVfWkfxeraBv8o0qqkHGUA$8m+56g0B/rw+fhbZDZnkrNghAO+B6zLcDz3mPlHvWOg helper:none:$argon2id$v=19$m=19456,t=2,p=1$KVfWkfxeraBv8o0qqkHGUA$8m+56g0B/rw+fhbZDZnkrNghAO+B6zLcDz3mPlHvWOg'
# Signs the login's JWTs; rotating it, or changing a user, logs every browser out. Dev only,
# make a real one with `openssl rand -base64 32`.
INNBY_ADMIN_JWT_SECRET=ZGV2LW9ubHktYWRtaW4tand0LXNlY3JldC1kby1ub3QtdXNlLWluLXByb2Q=
# Where hosts reach the admin UI: on a hostname of its own, or under a path of the
# site's, as https://fest.example.com/admin, which it then serves its pages under. The
# mailer needs it too, for the links that let users made in the admin UI set a password.
INNBY_ADMIN_URL=http://localhost:8081
# Single sign-on to the admin UI, as well as or instead of the users above (leave out
# INNBY_ADMIN_PASSWORD_HASH and INNBY_ADMIN_USERS to turn those off). Needs INNBY_ADMIN_URL: register
# {INNBY_ADMIN_URL}/login/oidc/callback with the provider.
# INNBY_OIDC_ISSUER=https://authelia.example.com
# INNBY_OIDC_CLIENT_ID=innby
# INNBY_OIDC_CLIENT_SECRET=
# The name on the login button, the scopes asked for, and the claim that lists the
# host's roles: admin, creator, editor, organiser or viewer. Without one, a host logs in only if an event
# gives them a role.
# INNBY_OIDC_NAME=Authelia
# INNBY_OIDC_SCOPES="openid profile email innby"
# INNBY_OIDC_ROLES_CLAIM=innby
# Minigames on the guests' pages, each id:points|time:Name, apart by lines or ";", with
# server: before the name for a game whose own server sends its scores; and the origin
# they're served from, which must not be the site's (see docs/games.md). `just up`
# serves the examples in games/ there. Games' servers send scores to
# INNBY_INTERNAL_LISTEN (0.0.0.0:8083).
INNBY_GAMES_URL=http://localhost:8082
INNBY_GAMES="reaction:time:Reaction; snake:points:server:Snake; tetris:points:server:Tetris; balloon:points:server:Balloon"
# innby mailer. INNBY_SMTP_URL is preset to Mailpit in the devcontainer; in the cluster use
# smtp://smtp.mailersend.net:587?tls=required with INNBY_SMTP_USER and INNBY_SMTP_PASSWORD.
INNBY_MAIL_FROM="Julebord <fest@example.com>"
# Each request is logged at info, but the kubelet's probes (/healthz, /readyz) only at
# debug, unless they fail: RUST_LOG=info,innby::http=debug logs them too.
RUST_LOG=info
