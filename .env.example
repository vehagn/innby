# Copy to .env for `just run`. Every FEST_*_NB value can have an FEST_*_EN
# counterpart; the English page falls back to the Norwegian text without one.
FEST_LISTEN=0.0.0.0:8080
# DATABASE_URL is preset in the devcontainer.
# The site's origin, without a path. Links in the admin UI and mails start with it.
FEST_BASE_URL=http://localhost:8080
# Signs every guest link; rotating it breaks all of them. Dev only, make a real one
# with `openssl rand -base64 32`.
FEST_LINK_KEY=ZGV2LW9ubHktbGluay1rZXktZG8tbm90LXVzZS1pbi1wcm9k
FEST_EVENT_TITLE_NB=Julebord
FEST_EVENT_TITLE_EN="Christmas party"
FEST_EVENT_DESCRIPTION_NB="Velkommen til julebord! Ta med godt humør."
FEST_EVENT_DESCRIPTION_EN="Welcome to our Christmas party! Bring your good mood."
FEST_EVENT_LOCATION="Storgata 1, Oslo"
# Local time in FEST_EVENT_TIMEZONE, formatted YYYY-MM-DDTHH:MM.
FEST_EVENT_START=2026-12-12T19:00
FEST_EVENT_TIMEZONE=Europe/Oslo
# The shared open RSVP link is /join/<code>; leave unset to switch the open RSVP off.
FEST_OPEN_RSVP_CODE=dev-join-code
# Behind the cluster gateway: rate-limit by the X-Forwarded-For address it appends.
# FEST_TRUST_FORWARDED=true
# Optional, same format: guests can answer until then (default: until the event starts).
# FEST_RSVP_DEADLINE=2026-12-01T23:59
# fest admin: basic auth for the host. Dev only: this is the hash of "fest". Make a real
# one with `just hash-password`.
FEST_ADMIN_LISTEN=0.0.0.0:8081
FEST_ADMIN_USER=admin
FEST_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$znL+taDv88jDpV/TXogByw$GCvbTJeJJQ7ACQv2UuifX0lm1T88a9d8Ytn0o+2kBHk'
# fest mailer. FEST_SMTP_URL is preset to Mailpit in the devcontainer; in the cluster use
# smtp://smtp.mailersend.net:587?tls=required with FEST_SMTP_USER and FEST_SMTP_PASSWORD.
FEST_MAIL_FROM="Julebord <fest@example.com>"
RUST_LOG=info
