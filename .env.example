# Copy to .env for `just up` in the dev container.
INNBY_LISTEN=0.0.0.0:8080
# DATABASE_URL is preset in the devcontainer.
# The site's origin, without a path. Links in the admin UI and mails start with it.
INNBY_BASE_URL=http://localhost:8080
# Signs every guest link; rotating it breaks all of them. Dev only, make a real one
# with `openssl rand -base64 32`.
INNBY_LINK_KEY=ZGV2LW9ubHktbGluay1rZXktZG8tbm90LXVzZS1pbi1wcm9k
# The data controller named in the privacy notice: you, the host.
INNBY_CONTROLLER_NAME="Kari Nordmann"
INNBY_CONTROLLER_EMAIL=kari@example.com
# Behind the cluster gateway: rate-limit by the X-Forwarded-For address it appends.
# INNBY_TRUST_FORWARDED=true
# innby admin: the host's login. Dev only: this is the hash of "innby". Make a real one
# with `just innby hash-password`.
INNBY_ADMIN_LISTEN=0.0.0.0:8081
INNBY_ADMIN_USER=admin
INNBY_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$eLkGWlrGr/4XIS1NIZhXQg$iMXvMhwsbHC/aFb/aAT34dDpXBp4PdHRrw286uFP1zo'
# Signs the login's JWTs; rotating it, or the password, logs every browser out. Dev only,
# make a real one with `openssl rand -base64 32`.
INNBY_ADMIN_JWT_SECRET=ZGV2LW9ubHktYWRtaW4tand0LXNlY3JldC1kby1ub3QtdXNlLWluLXByb2Q=
# Where hosts reach the admin UI: on a hostname of its own, or under a path of the
# site's, as https://fest.example.com/admin, which it then serves its pages under.
# INNBY_ADMIN_URL=http://localhost:8081
# Single sign-on to the admin UI, as well as or instead of the user above (leave out
# INNBY_ADMIN_PASSWORD_HASH to turn that off). Needs INNBY_ADMIN_URL: register
# {INNBY_ADMIN_URL}/login/oidc/callback with the provider.
# INNBY_OIDC_ISSUER=https://authelia.example.com
# INNBY_OIDC_CLIENT_ID=innby
# INNBY_OIDC_CLIENT_SECRET=
# The name on the login button, the scopes asked for, and the claim that lists the
# host's roles: admin, editor or viewer.
# INNBY_OIDC_NAME=Authelia
# INNBY_OIDC_SCOPES="openid profile email innby"
# INNBY_OIDC_ROLES_CLAIM=innby
# innby mailer. INNBY_SMTP_URL is preset to Mailpit in the devcontainer; in the cluster use
# smtp://smtp.mailersend.net:587?tls=required with INNBY_SMTP_USER and INNBY_SMTP_PASSWORD.
INNBY_MAIL_FROM="Julebord <fest@example.com>"
RUST_LOG=info
