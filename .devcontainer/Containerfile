# Development container for Innby: the Rust toolchain, cross-compilation to static
# amd64 and arm64 musl binaries, clients for Postgres and Kubernetes, oha for `just
# bench`, Node.js for the example games in games/, and a zsh with oh-my-zsh. Bump the pinned versions below and rebuild to upgrade.
FROM docker.io/library/rust:1.99.1-trixie

ARG USERNAME=dev
ARG USER_UID=1000
ARG ZIG_VERSION=0.16.0
ARG ZIG_SHA256_X86_64=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ARG ZIG_SHA256_AARCH64=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
ARG KUBECTL_VERSION=1.35.10
ARG KUBESEAL_VERSION=0.38.4
ARG HELM_VERSION=4.3.1
ARG HELM_SHA256_AMD64=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
ARG HELM_SHA256_ARM64=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88
ARG KUBECONFORM_VERSION=0.8.0
ARG KUBECONFORM_SHA256_AMD64=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
ARG KUBECONFORM_SHA256_ARM64=1f53fc8e81258197a35e8603054162a5af1de8c5af13746c71ab680d9534ed87
ARG CARGO_BINSTALL_VERSION=1.26.2
ARG JUST_VERSION=1.59.0
ARG CARGO_ZIGBUILD_VERSION=0.24.0
ARG CARGO_DENY_VERSION=0.20.2
ARG SQLX_CLI_VERSION=0.9.0
ARG OHA_VERSION=1.16.0
# oh-my-zsh, and the devcontainers prompt and shell snippets, pinned to a commit.
ARG OH_MY_ZSH_COMMIT=b509b1c6ed0c1ba37de12cbd37f30b2b2f61193a
ARG DEVCONTAINERS_FEATURES_COMMIT=ad7094ecdc1d5d3b28e5b727591a12bf104fa853

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# psql 18 from the PostgreSQL apt repository.
RUN apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      bash-completion file htop iproute2 jq less locales lsof ncdu neovim nodejs openssh-client \
      postgresql-client-18 procps psmisc skopeo sudo tree unzip vim xz-utils yamllint zsh; \
    rm -rf /var/lib/apt/lists/*; \
    sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen; \
    locale-gen

# The devcontainers shell snippets and prompts, as VS Code's own images have them.
RUN base="https://raw.githubusercontent.com/devcontainers/features/${DEVCONTAINERS_FEATURES_COMMIT}/src/common-utils/scripts"; \
    install -d /usr/local/share/devcontainers; \
    cd /usr/local/share/devcontainers; \
    for file in rc_snippet.sh bash_theme_snippet.sh devcontainers.zsh-theme; do \
      curl -fsSL -o "${file}" "${base}/${file}"; \
    done; \
    sha256sum -c - <<'EOF'
386211422128f024f627070d030cd1034984197e97dd61b9e652d813b13360ea  rc_snippet.sh
3a9a8fa86ff1643d9976f4ec9711fbec11b8f38576ea256bb2a7fce3267ae3ed  bash_theme_snippet.sh
598772c994f1179ef44890d89b51a16a1162feaef8224f5bd1ca2dd9d18ec0e0  devcontainers.zsh-theme
EOF
RUN cat /usr/local/share/devcontainers/rc_snippet.sh >> /etc/bash.bashrc; \
    cat /usr/local/share/devcontainers/rc_snippet.sh >> /etc/zsh/zshrc

# Zig is the cross-linker used by cargo-zigbuild.
RUN arch="$(uname -m)"; \
    case "${arch}" in \
      x86_64) sha="${ZIG_SHA256_X86_64}" ;; \
      aarch64) sha="${ZIG_SHA256_AARCH64}" ;; \
      *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-${arch}-linux-${ZIG_VERSION}.tar.xz"; \
    echo "${sha}  /tmp/zig.tar.xz" | sha256sum -c -; \
    install -d /opt/zig; \
    tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1; \
    ln -s /opt/zig/zig /usr/local/bin/zig; \
    rm /tmp/zig.tar.xz

# kubectl matches the cluster's minor version, kubeseal matches the sealed-secrets controller.
RUN arch="$(dpkg --print-architecture)"; \
    kubectl_url="https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${arch}/kubectl"; \
    curl -fsSL -o /usr/local/bin/kubectl "${kubectl_url}"; \
    echo "$(curl -fsSL "${kubectl_url}.sha256")  /usr/local/bin/kubectl" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/kubectl; \
    kubeseal_base="https://github.com/bitnami/sealed-secrets/releases/download/v${KUBESEAL_VERSION}"; \
    kubeseal_tar="kubeseal-${KUBESEAL_VERSION}-linux-${arch}.tar.gz"; \
    curl -fsSL -o "/tmp/${kubeseal_tar}" "${kubeseal_base}/${kubeseal_tar}"; \
    curl -fsSL "${kubeseal_base}/sealed-secrets_${KUBESEAL_VERSION}_checksums.txt" \
      | grep " ${kubeseal_tar}\$" | (cd /tmp && sha256sum -c -); \
    tar -xzf "/tmp/${kubeseal_tar}" -C /usr/local/bin kubeseal; \
    rm "/tmp/${kubeseal_tar}"

# Helm for the chart in charts/innby, and kubeconform to check what it renders.
RUN arch="$(dpkg --print-architecture)"; \
    case "${arch}" in \
      amd64) helm_sha="${HELM_SHA256_AMD64}"; kubeconform_sha="${KUBECONFORM_SHA256_AMD64}" ;; \
      arm64) helm_sha="${HELM_SHA256_ARM64}"; kubeconform_sha="${KUBECONFORM_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/helm.tar.gz "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${arch}.tar.gz"; \
    echo "${helm_sha}  /tmp/helm.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/helm.tar.gz -C /usr/local/bin --strip-components=1 "linux-${arch}/helm"; \
    curl -fsSL -o /tmp/kubeconform.tar.gz "https://github.com/yannh/kubeconform/releases/download/v${KUBECONFORM_VERSION}/kubeconform-linux-${arch}.tar.gz"; \
    echo "${kubeconform_sha}  /tmp/kubeconform.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/kubeconform.tar.gz -C /usr/local/bin kubeconform; \
    rm /tmp/helm.tar.gz /tmp/kubeconform.tar.gz

RUN rustup component add clippy rustfmt rust-src rust-analyzer; \
    rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl

# Non-root user with passwordless sudo. Directories that compose mounts volumes onto
# are created here so the volumes inherit the user's ownership.
RUN useradd --create-home --shell /bin/zsh --uid "${USER_UID}" "${USERNAME}"; \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    install -d -o "${USERNAME}" -g "${USERNAME}" \
      "/home/${USERNAME}/.kube" \
      "/home/${USERNAME}/.cache/kube" \
      "/home/${USERNAME}/.cache/target" \
      "/home/${USERNAME}/.local/state/shell" \
      "${CARGO_HOME}/registry"; \
    chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}" "${CARGO_HOME}"; \
    # The workspace is mounted from the host, owned by another UID.
    git config --system --add safe.directory /workspaces/innby

USER ${USERNAME}

RUN curl -fsSL "https://github.com/cargo-bins/cargo-binstall/releases/download/v${CARGO_BINSTALL_VERSION}/cargo-binstall-$(uname -m)-unknown-linux-musl.tgz" \
      | tar -xz -C "${CARGO_HOME}/bin"; \
    cargo binstall --no-confirm --locked --disable-strategies compile \
      "just@${JUST_VERSION}" \
      "cargo-zigbuild@${CARGO_ZIGBUILD_VERSION}" \
      "cargo-deny@${CARGO_DENY_VERSION}" \
      "oha@${OHA_VERSION}"; \
    cargo install --locked --no-default-features --features rustls,postgres "sqlx-cli@${SQLX_CLI_VERSION}"; \
    rm -rf "${CARGO_HOME}/registry/"* "${CARGO_HOME}/git"

# zsh with oh-my-zsh and the devcontainers prompt, completion for just, kubectl, rustup
# and cargo, and the shell history in a volume, so it outlives rebuilds. Bash gets the
# same prompt, aliases and history.
RUN git init --quiet ~/.oh-my-zsh; \
    git -C ~/.oh-my-zsh fetch --quiet --depth=1 https://github.com/ohmyzsh/ohmyzsh "${OH_MY_ZSH_COMMIT}"; \
    git -C ~/.oh-my-zsh checkout --quiet FETCH_HEAD; \
    install -D -m 0644 /usr/local/share/devcontainers/devcontainers.zsh-theme \
      ~/.oh-my-zsh/custom/themes/devcontainers.zsh-theme; \
    install -d ~/.zfunc ~/.local/share/bash-completion/completions; \
    just --completions zsh > ~/.zfunc/_just; \
    just --completions bash > ~/.local/share/bash-completion/completions/just; \
    { printf '%s\n' \
        "zstyle ':omz:update' mode disabled" \
        'fpath=(~/.zfunc $fpath)' \
        'HISTFILE=~/.local/state/shell/zsh_history' \
        'HISTSIZE=50000' \
        'SAVEHIST=50000'; \
      sed -e 's/^ZSH_THEME=.*/ZSH_THEME="devcontainers"/' \
          -e 's/^plugins=.*/plugins=(git kubectl rust)/' \
          ~/.oh-my-zsh/templates/zshrc.zsh-template; \
      echo '[ -f ~/.bash_aliases ] && source ~/.bash_aliases'; \
    } > ~/.zshrc; \
    cat /usr/local/share/devcontainers/bash_theme_snippet.sh >> ~/.bashrc; \
    echo 'HISTFILE=~/.local/state/shell/bash_history' >> ~/.bashrc; \
    printf '%s\n' \
      "alias k='kubectl'" \
      "alias kz='kubectl kustomize'" \
      "alias yl='yamllint'" \
      > ~/.bash_aliases

# Neovim reads Vim's ~/.vimrc and ~/.vim, which `just dev` mounts from the host. A host
# ~/.config/nvim, mounted over this, wins.
RUN mkdir -p "/home/${USERNAME}/.config/nvim"; \
    printf '%s\n' \
      'set runtimepath^=~/.vim runtimepath+=~/.vim/after' \
      'let &packpath = &runtimepath' \
      'if filereadable(expand("~/.vimrc")) | source ~/.vimrc | endif' \
      > "/home/${USERNAME}/.config/nvim/init.vim"

ENV CARGO_TARGET_DIR=/home/${USERNAME}/.cache/target \
    KUBECACHEDIR=/home/${USERNAME}/.cache/kube \
    EDITOR=vim \
    LANG=en_US.UTF-8

WORKDIR /workspaces/innby
