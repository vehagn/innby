# Edit before deploying. Everything here is public; secrets go in secrets.env.
INNBY_BASE_URL=https://fest.stonegarden.dev
# The data controller named on /privacy: you.
INNBY_CONTROLLER_NAME=Vegard Hagen
INNBY_CONTROLLER_EMAIL=fest@stonegarden.dev
# The sender domain must be verified in MailerSend (SPF, DKIM, DMARC).
INNBY_MAIL_FROM=Julebord <fest@stonegarden.dev>
INNBY_SMTP_URL=smtp://smtp.mailersend.net:587?tls=required
# The gateway appends the client address to X-Forwarded-For.
INNBY_TRUST_FORWARDED=true
RUST_LOG=info
