# Edit before deploying. Everything here is public; secrets go in secrets.env.
FEST_BASE_URL=https://fest.stonegarden.dev
FEST_EVENT_TITLE_NB=Julebord
FEST_EVENT_TITLE_EN=Christmas party
FEST_EVENT_DESCRIPTION_NB=Velkommen til julebord!
FEST_EVENT_DESCRIPTION_EN=Welcome to our Christmas party!
FEST_EVENT_LOCATION=Storgata 1, Oslo
FEST_EVENT_START=2026-12-12T19:00
FEST_EVENT_TIMEZONE=Europe/Oslo
# FEST_RSVP_DEADLINE=2026-12-01T23:59
# The data controller named on /privacy: you.
FEST_CONTROLLER_NAME=Vegard Hagen
FEST_CONTROLLER_EMAIL=fest@stonegarden.dev
# The sender domain must be verified in MailerSend (SPF, DKIM, DMARC).
FEST_MAIL_FROM=Julebord <fest@stonegarden.dev>
FEST_SMTP_URL=smtp://smtp.mailersend.net:587?tls=required
# The gateway appends the client address to X-Forwarded-For.
FEST_TRUST_FORWARDED=true
RUST_LOG=info
