# Copy to secrets.env (gitignored), fill in, and run `just seal`.
# openssl rand -base64 32
FEST_LINK_KEY=
# The secret part of /join/<code>, at least 16 characters: openssl rand -hex 10
# Leave empty to keep the open RSVP off.
FEST_OPEN_RSVP_CODE=
# just hash-password
FEST_ADMIN_PASSWORD_HASH=
# MailerSend SMTP user (Domains → SMTP)
FEST_SMTP_USER=
FEST_SMTP_PASSWORD=
