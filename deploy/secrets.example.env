# Copy to secrets.env (gitignored), fill in, and run `just seal`.
# openssl rand -base64 32
INNBY_LINK_KEY=
# just innby hash-password. Leave it out to turn the built-in user off, once single
# sign-on works.
INNBY_ADMIN_PASSWORD_HASH=
# More users with a password, each name:role:hash (the role admin, editor or viewer),
# apart by spaces.
# INNBY_ADMIN_USERS=
# openssl rand -base64 32
INNBY_ADMIN_JWT_SECRET=
# MailerSend SMTP user (Domains → SMTP)
INNBY_SMTP_USER=
INNBY_SMTP_PASSWORD=
# Single sign-on: the client secret Authelia has the hash of. Leave it out without it.
# INNBY_OIDC_CLIENT_SECRET=
