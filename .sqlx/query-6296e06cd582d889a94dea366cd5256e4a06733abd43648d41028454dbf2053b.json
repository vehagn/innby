  "db_name": "PostgreSQL",
  "query": "\n        select id, rsvp_id, admin_user, lang as \"lang: Lang\", kind as \"kind: Kind\", attempts,\n            created_at\n        from outbox\n        where sent_at is null and next_try_at <= now() and attempts < $2\n        order by id\n        limit $1\n        for update skip locked\n        ",
